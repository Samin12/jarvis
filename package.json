{
  "name": "jarvis",
  "version": "0.2.0",
  "description": "Jarvis — sign in with ChatGPT, talk to a live voice assistant, connect your apps, dispatch Codex.",
  "main": "./out/main/index.js",
  "author": "Samin Yasar",
  "homepage": "https://github.com/Samin12/jarvis",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check src tests scripts/*.mjs *.config.ts package*.json *.yml .github/workflows/*.yml",
    "lint": "eslint --cache src tests scripts/*.mjs electron.vite.config.ts vitest.config.ts playwright.config.ts eslint.config.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:native:mac": "./scripts/build-macos-speech.sh release",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:native": "swift test --package-path native/macos-speech --jobs 1 && node scripts/test-workspace-helper.mjs",
    "test:e2e": "npm run build && npm run verify:smoke",
    "verify:smoke": "node scripts/verify-electron-smoke.mjs",
    "verify:ci": "node scripts/verify-ci.mjs",
    "verify:native-stage": "node scripts/verify-macos-speech-stage.mjs",
    "verify:release-config": "node scripts/verify-release-secrets.mjs --config-only",
    "verify:release-secrets": "node scripts/verify-release-secrets.mjs",
    "verify:package:dev": "node scripts/verify-unpacked-app.mjs",
    "verify:package:artifacts:dev": "node scripts/verify-packaged-app.mjs --mode development",
    "verify:package": "node scripts/verify-packaged-app.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "./scripts/package-macos.sh development dir",
    "build:unpack:mac": "./scripts/package-macos.sh development dir",
    "build:release:mac": "./scripts/package-macos.sh release artifacts",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "./scripts/package-macos.sh development artifacts",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/big-shoulders": "^5.2.6",
    "@fontsource/martian-mono": "^5.2.7",
    "@openai/codex-sdk": "0.144.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "4.1.10"
  }
}
